# Copia este archivo como .env.local y completa los valores de tu proyecto de Supabase.
# En el panel: botón "Connect" → App Frameworks → React + Vite, o Project Settings → Data API / API Keys.
# Si se dejan vacíos, la app funciona en modo local: sin cuentas, con todo guardado en el navegador.
VITE_SUPABASE_URL=

# Usa UNA de las dos: la clave "anon public" clásica (empieza por eyJ...)
VITE_SUPABASE_ANON_KEY=
# ...o la "publishable key" nueva (empieza por sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=
